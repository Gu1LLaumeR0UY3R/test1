{% extends 'base.html.twig' %}

{% block title %}Hello CoucouController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello ! ✅</h1>
    <p> {{ message }} </p>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/app/src/Controller/CoucouController.php</code></li>
        <li>Your template at <code>/app/templates/coucou/index.html.twig</code></li>
    </ul>


    <h1>HI</h1>
    <p>{{ message }}</p>
    <p>{{ dump(groupes) }}</p>
    <ul>
        {% for groupe in groupes %}
        <li>Groupe : {{ groupe.nom }}</li>
        <li>
            <ul>
                <li> Propriétaire : {{ groupe.proprietaire.email }}</li>
                <li> Membres :
                    {# <ul>
                        {% for membre in groupe.membres %}
                            <li>{{ membre.utilisateur.email }}</li>
                        {% endfor %}
                    </ul> #}
            </ul>
        </li>
        {% endfor %}
    </ul>
</div>

{% endblock %}
